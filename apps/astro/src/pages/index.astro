---
// The feed's front page: the unfiltered feed, page 1, prerendered into
// `index.html`.
//
// The asset store answers `/` with that file, and the worker entry that fronts
// the root (see `main` in `wrangler.jsonc`) hands a queryless visitor to it
// directly; `[...feed].astro` renders the same page on demand for anything the
// asset store does not answer. All three use this one component over the one
// query, so the root has a single markup path.
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import Feed from "../components/Feed.astro";
import { getDb } from "../lib/db";
import { loadFeed } from "../lib/db/queries";
import { feedDescription, feedTitle } from "../lib/feed-routes";

const page = await loadFeed(getDb(), null, 1);
---

<Layout title={feedTitle(page)} description={feedDescription(page)}>
  <Feed page={page} />
</Layout>
