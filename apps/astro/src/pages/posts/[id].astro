---
// Post detail: full-bleed editorial hero, source/tags, and bento recommendations.
// Tile captions overlay the artwork; gallery images retain their lightbox.

import Layout from "../../layouts/Layout.astro";
import { getDb } from "../../lib/db";
import { loadPost, type Recommendation } from "../../lib/db/queries";
import { feedHref } from "../../lib/feed-paths";

const postId = Astro.params.id;
const post = postId ? await loadPost(getDb(), postId) : null;

// A post whose images Reddit has deleted is no longer a page: it is treated as
// not found rather than served as a hero-less shell.
if (!post) Astro.response.status = 404;

const modalSlideId = (i: number) => `modal-slide${i + 1}`;
const modalPrev = (i: number, total: number) => (i === 0 ? `#${modalSlideId(total - 1)}` : `#${modalSlideId(i - 1)}`);
const modalNext = (i: number, total: number) => (i === total - 1 ? `#${modalSlideId(0)}` : `#${modalSlideId(i + 1)}`);
const galleryImages = post?.images.slice(0, 10) ?? [];
const totalImages = galleryImages.length;
const tagHref = (tag: string) => feedHref(tag);
const redditHref = (permalink: string) => `https://reddit.com${permalink}`;

const externalHref = (rec: Recommendation): string | null => {
  if (rec.imdbId) return `https://www.imdb.com/title/${rec.imdbId}/`;
  if (rec.tmdbId) {
    const tmdbType = rec.mediaType === "tv" ? "tv" : rec.mediaType === "game" ? "game" : "movie";
    return `https://www.themoviedb.org/${tmdbType}/${rec.tmdbId}`;
  }
  return rec.externalUrl ?? null;
};
const externalLabel = (rec: Recommendation): string => {
  if (rec.imdbId) return "IMDb";
  if (rec.tmdbId) return "TMDB";
  return rec.externalUrl ? "Source" : "";
};

type ImageRole = "poster" | "backdrop";

/**
 * TMDB has a documented size ladder. Other providers, including IMDb, must
 * keep their exact supplied URL rather than receiving a fabricated variant.
 */
const responsiveImage = (url: string, role: ImageRole, sizes: string) => {
  const match = url.match(/^https:\/\/image\.tmdb\.org\/t\/p\/[^/]+(\/.*)$/);
  if (!match) return { src: url, sizes };

  const widths = role === "poster" ? [300, 500, 780] : [500, 780, 1280];
  const makeUrl = (width: number) => `https://image.tmdb.org/t/p/w${width}${match[1]}`;

  return {
    src: makeUrl(widths[1]),
    srcset: widths.map((width) => `${makeUrl(width)} ${width}w`).join(", "),
    sizes,
  };
};
---

<Layout title={post ? `${post.vibeSummary ?? "Vibe post"} — Movies That Feel Like` : "Post not found"}>
  {!post ? (
    <div class="hero min-h-64 rounded-box border border-line bg-paper transition-colors duration-240 ease-theme motion-reduce:transition-none theme-dark:border-line-dark theme-dark:bg-paper-dark">
      <div class="hero-content text-center">
        <div class="max-w-md">
          <h2 class="text-xl font-bold">Post not found</h2>
          <p class="py-4 text-quiet transition-colors duration-240 ease-theme motion-reduce:transition-none theme-dark:text-quiet-dark">
            No post with ID "{Astro.params.id}" was found in the database.
          </p>
          <a href="/" class="btn btn-primary focus-visible:outline-2 focus-visible:outline-red focus-visible:outline-offset-4 theme-dark:outline-red-dark">Back to feed</a>
        </div>
      </div>
    </div>
  ) : (
    <div class="pb-24">
      <section class="post-hero" aria-label="Post hero">
        <div class="relative h-full">
          <div
            class="hero-images h-full w-full overflow-hidden bg-gallery"
            transition:name={`post-image-${post.redditPostId}`}
            data-hero-gallery
            aria-label={`Image gallery. ${totalImages} image${totalImages === 1 ? "" : "s"}.`}
          >
            {galleryImages.map((img, i) => {
              const primaryUrl = img.previewUrl ?? img.sourceUrl;
              const fallbackUrls = [img.sourceUrl]
                .filter((url): url is string => typeof url === "string" && url.trim().length > 0)
                .filter((url) => url !== primaryUrl);
              return (
              <div class="hero-image" data-hero-slide data-active={i === 0 ? "true" : "false"} inert={i !== 0}>
                <button
                  type="button"
                  class="block h-full w-full focus-visible:outline-2 focus-visible:outline-red focus-visible:outline-offset-4 theme-dark:outline-red-dark"
                  data-open-lightbox={i}
                  aria-label={`Open image ${i + 1} of ${totalImages} at full size`}
                >
                  <div class="relative h-full w-full">
                    <img
                      src={primaryUrl}
                      data-fallback-urls={JSON.stringify(fallbackUrls)}
                      alt={`Post image ${i + 1} of ${totalImages}`}
                      class="h-full w-full object-cover"
                      loading={i === 0 ? "eager" : "lazy"}
                      decoding="async"
                      fetchpriority={i === 0 ? "high" : undefined}
                      data-fallback-image
                    />
                    <span class="absolute inset-0 hidden items-center justify-center bg-gallery-empty text-no-image text-gallery-empty-text" data-image-fallback aria-hidden="true">No image loaded.</span>
                  </div>
                </button>
              </div>
              );
            })}
          </div>
          <div class="post-hero-shade" aria-hidden="true"></div>
          <div class="post-hero-heading">
            <h1 transition:name={`post-vibe-${post.redditPostId}`}>
              {post.vibeSummary ?? post.title}
            </h1>
            {totalImages > 1 && (
              <div class="hero-pagination">
                <div class="hero-thumbnails" role="group" aria-label="Choose hero image">
                  {galleryImages.map((img, i) => (
                    <button
                      type="button"
                      data-hero-thumbnail={i}
                      aria-label={`Show image ${i + 1} of ${totalImages}`}
                      aria-pressed={i === 0 ? "true" : "false"}
                    >
                      <img src={img.previewUrl ?? img.sourceUrl} alt="" loading="lazy" decoding="async" />
                    </button>
                  ))}
                </div>
                <button type="button" class="hero-playback" data-hero-playback aria-label="Pause automatic image changes">Pause</button>
              </div>
            )}
          </div>
        </div>
      </section>

      <div class="post-source">
        <p class="text-quiet theme-dark:text-quiet-dark">
          “{post.title}”
          {post.permalink && (
            <a href={redditHref(post.permalink)} class="ml-2 whitespace-nowrap underline focus-visible:outline-2 focus-visible:outline-red focus-visible:outline-offset-4 theme-dark:outline-red-dark" target="_blank" rel="noopener noreferrer">Thread ↗</a>
          )}
        </p>
      {post.tags.length > 0 && (
        <nav aria-label="Post tags">
          <ul class="flex flex-row flex-wrap gap-2">
            {post.tags.map((tag) => (
              <li class="shrink-0">
                <a
                  href={tagHref(tag)}
                  class="inline-flex items-center rounded-full border border-ink/40 bg-transparent px-3 py-1 text-label uppercase tracking-theme text-ink transition-colors duration-240 ease-theme motion-reduce:transition-none hover:border-red hover:text-red focus-visible:outline-2 focus-visible:outline-red focus-visible:outline-offset-4 theme-dark:border-ink-dark/40 theme-dark:text-ink-dark theme-dark:outline-red-dark theme-dark:hover:border-red-dark theme-dark:hover:text-red-dark"
                >{tag}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
      </div>

      {post.recommendations.length > 0 && (
        <section aria-label="Recommendations">
          <div class="grid grid-cols-2 gap-4 md:grid-cols-5 md:gap-4">
            {post.recommendations.map((rec, i) => {
              const href = externalHref(rec);
              const isGalleryHero = post.recommendations.length >= 5 && i === 0;
              const isFourCardLead = post.recommendations.length === 4 && i === 0;
              const isSparseHero = post.recommendations.length === 1 && i === 0;
              const isThreeCardWide = post.recommendations.length === 3 && i === 0;
              const isSixth = post.recommendations.length >= 6 && i === 5;
              const nonHeroCount = post.recommendations.length - 1;
              let trailingSpan = 1;

              // Keep the cards around the two-column feature balanced, then
              // widen the final card to close a partial row.
              if (isThreeCardWide || isSixth) {
                trailingSpan = 2;
              } else if (!isGalleryHero && post.recommendations.length >= 4 && i > 0) {
                if (nonHeroCount < 5 && i === post.recommendations.length - 1) {
                  const remainder = nonHeroCount % 3;
                  trailingSpan = remainder === 1 ? 3 : remainder === 2 ? 2 : 1;
                } else if (nonHeroCount > 5 && i > 5) {
                  const positionAfterFeatureRows = i - 5;
                  const remainingAfterFeatureRows = nonHeroCount - 5;
                  const remainder = remainingAfterFeatureRows % 5;

                  if (positionAfterFeatureRows === remainingAfterFeatureRows) {
                    trailingSpan = remainder === 1 ? 5 : remainder === 2 ? 4 : remainder === 3 ? 3 : remainder === 4 ? 2 : 1;
                  }
                }
              }

              const isWide = trailingSpan > 1;
              const trailingSpanClass = trailingSpan === 5
                ? "md:col-span-5"
                : trailingSpan === 4
                  ? "md:col-span-4"
                  : trailingSpan === 3
                  ? "md:col-span-3"
                  : "md:col-span-2";
              const wideDesktopSize = trailingSpan === 5 ? "100vw" : trailingSpan === 4 ? "80vw" : trailingSpan === 3 ? "60vw" : "40vw";
              const isWideArt = isGalleryHero || isFourCardLead || isSparseHero || isWide;
              const usesBackdrop = !isGalleryHero && isWideArt && !!rec.backdropUrl;
              const imageUrl = usesBackdrop ? rec.backdropUrl : rec.posterUrl;
              const imageSizes = isGalleryHero
                ? "(min-width: 768px) 25vw, 100vw"
                : isFourCardLead
                  ? `(min-width: 768px) ${wideDesktopSize}, 100vw`
                : isSparseHero
                  ? "100vw"
                : isWide
                  ? `(min-width: 768px) ${wideDesktopSize}, 100vw`
                  : "(min-width: 768px) 25vw, 50vw";
              const image = imageUrl
                ? responsiveImage(imageUrl, usesBackdrop ? "backdrop" : "poster", imageSizes)
                : null;
              const cardClass = [
                "recommendation-tile group relative block overflow-hidden bg-gallery focus-visible:outline-2 focus-visible:outline-red focus-visible:outline-offset-4 theme-dark:outline-red-dark",
                !isGalleryHero && !isFourCardLead && !isSparseHero && "aspect-poster",
                isGalleryHero && "col-span-2 aspect-recommendation-hero md:col-span-2 md:col-start-1 md:row-start-1 md:row-span-2 md:aspect-auto md:h-full",
                isFourCardLead && "col-span-2 aspect-recommendation-hero md:col-span-2 md:aspect-auto md:h-full",
                isSparseHero && "col-span-2 aspect-recommendation-hero md:col-span-4",
                isWide && `${trailingSpanClass} md:aspect-auto md:h-full`,
              ].filter(Boolean).join(" ");
              const cardInner = (
                <>
                  <div class="absolute inset-0 overflow-hidden bg-gallery">
                    {image ? (
                      <img
                        src={image.src}
                        {...(image.srcset ? { srcset: image.srcset } : {})}
                        sizes={image.sizes}
                        alt={rec.title}
                        class:list={[
                          "h-full w-full transition duration-450 ease-gallery motion-reduce:transition-none group-hover:scale-105 group-focus-visible:scale-105",
                          isGalleryHero || usesBackdrop ? "object-cover object-center" : "object-contain",
                        ]}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <div class="flex h-full w-full items-center justify-center text-no-image text-quiet transition-colors duration-240 ease-theme motion-reduce:transition-none theme-dark:text-quiet-dark">No poster</div>
                    )}
                  </div>
                  <div class="recommendation-caption pointer-events-none absolute inset-x-0 bottom-0 px-3 pb-3 pt-12 text-paper">
                    <h3 class:list={["flex items-baseline gap-1 font-semibold leading-tight", isGalleryHero || isFourCardLead || isSparseHero ? "text-xl" : "text-base"]}>
                      <span class="min-w-0">{rec.title}</span>
                      {href && (
                        <span class="shrink-0" aria-hidden="true">↗</span>
                      )}
                    </h3>
                    <p class="mt-1 text-xs text-paper/75">
                      {rec.releaseYear ?? "—"}
                    {rec.voteAverage != null && (
                      <>
                        <span aria-hidden="true"> · </span>
                        <span aria-label={`Rating ${rec.voteAverage.toFixed(1)} out of 10`}>★ {rec.voteAverage.toFixed(1)}</span>
                      </>
                    )}
                    </p>
                  </div>
                </>
              );
              return href ? (
                <a
                  href={href}
                  class={cardClass}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${rec.title}${rec.releaseYear ? ` (${rec.releaseYear})` : ""} on ${externalLabel(rec)} (opens in a new tab)`}
                >
                  {cardInner}
                </a>
              ) : (
                <div class={cardClass}>
                  {cardInner}
                </div>
              );
            })}
          </div>
        </section>
      )}

      <dialog id="hero-lightbox" class="modal" aria-label="Image lightbox">
        <div class="modal-box max-w-[min(95vw,1600px)] h-[90vh] w-full bg-paper/0 p-0 shadow-none motion-reduce:transition-none theme-dark:bg-paper-dark/0">
          <form method="dialog" class="absolute right-2 top-2 z-10">
            <button
              type="submit"
              class="btn btn-circle btn-sm border border-ink/20 bg-paper/90 text-ink hover:bg-paper focus-visible:outline-2 focus-visible:outline-red focus-visible:outline-offset-4 motion-reduce:transition-none theme-dark:border-ink-dark/20 theme-dark:bg-paper-dark/90 theme-dark:text-ink-dark theme-dark:hover:bg-paper-dark theme-dark:outline-red-dark"
              aria-label="Close lightbox"
            >✕</button>
          </form>
          <div
            class="carousel h-full w-full overflow-hidden bg-ink/95 motion-reduce:transition-none theme-dark:bg-ink-dark/95"
            data-modal-carousel
            aria-label={`Image gallery lightbox. ${totalImages} image${totalImages === 1 ? "" : "s"}.`}
          >
            {galleryImages.map((img, i) => {
              const primaryUrl = img.previewUrl ?? img.sourceUrl;
              const fallbackUrls = [img.sourceUrl]
                .filter((url): url is string => typeof url === "string" && url.trim().length > 0)
                .filter((url) => url !== primaryUrl);
              return (
              <div id={modalSlideId(i)} class="carousel-item relative h-full w-full">
                <div class="relative h-full w-full">
                  <img
                    src={primaryUrl}
                    data-fallback-urls={JSON.stringify(fallbackUrls)}
                    alt={`Post image ${i + 1} of ${totalImages}`}
                    class="h-full w-full object-contain"
                    loading={i === 0 ? "eager" : "lazy"}
                    decoding="async"
                    data-fallback-image
                  />
                  <span class="absolute inset-0 hidden items-center justify-center bg-gallery-empty text-no-image text-gallery-empty-text" data-image-fallback aria-hidden="true">No image loaded.</span>
                </div>
                {totalImages > 1 && (
                  <>
                    <a
                      href={modalPrev(i, totalImages)}
                      data-carousel-control
                      class="btn btn-circle absolute left-3 top-1/2 -translate-y-1/2 border border-paper/30 bg-paper/90 text-ink hover:bg-paper focus-visible:outline-2 focus-visible:outline-red focus-visible:outline-offset-4 motion-reduce:transition-none sm:left-5 theme-dark:border-paper-dark/30 theme-dark:bg-paper-dark/90 theme-dark:text-ink-dark theme-dark:hover:bg-paper-dark theme-dark:outline-red-dark"
                      aria-label="Show previous image"
                    >
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
                        <path d="m15 18-6-6 6-6" />
                      </svg>
                    </a>
                    <a
                      href={modalNext(i, totalImages)}
                      data-carousel-control
                      class="btn btn-circle absolute right-3 top-1/2 -translate-y-1/2 border border-paper/30 bg-paper/90 text-ink hover:bg-paper focus-visible:outline-2 focus-visible:outline-red focus-visible:outline-offset-4 motion-reduce:transition-none sm:right-5 theme-dark:border-paper-dark/30 theme-dark:bg-paper-dark/90 theme-dark:text-ink-dark theme-dark:hover:bg-paper-dark theme-dark:outline-red-dark"
                      aria-label="Show next image"
                    >
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
                        <path d="m9 18 6-6-6-6" />
                      </svg>
                    </a>
                  </>
                )}
              </div>
              );
            })}
          </div>
        </div>
        <form method="dialog" class="modal-backdrop">
          <button aria-label="Close lightbox">close</button>
        </form>
      </dialog>
    </div>
  )}
</Layout>

<style>
  .post-hero {
    min-height: max(420px, min(82svh, 760px));
    margin-inline: calc(50% - 50vw);
    background: var(--color-gallery);
  }

  .post-hero > div {
    display: grid;
    min-height: inherit;
    align-items: end;
  }

  .post-hero :global([data-hero-gallery]) {
    position: absolute;
    inset: 0;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 1600ms cubic-bezier(.45, 0, .55, 1);
  }

  .hero-image[data-active="true"] {
    opacity: 1;
    pointer-events: auto;
  }

  .post-hero-shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, oklch(12% .02 50 / .92), oklch(12% .02 50 / .45) 45%, transparent 75%);
  }

  .post-hero-heading {
    position: relative;
    padding: 120px var(--spacing-gutter) 40px;
    pointer-events: none;
    color: var(--color-paper);
    display: grid;
    align-items: end;
    gap: 28px;
  }

  .post-hero-heading h1 {
    max-width: 16ch;
    margin: 0;
    font-size: clamp(2.6rem, 1.2rem + 4.6vw, 5.8rem);
    font-weight: 400;
    font-style: italic;
    line-height: .98;
    letter-spacing: -.025em;
    text-wrap: balance;
  }

  .hero-pagination {
    min-width: 0;
    pointer-events: auto;
  }

  .hero-thumbnails {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    width: min(100%, 312px);
    gap: 8px;
    overflow: visible;
    padding: 4px;
  }

  .hero-thumbnails button {
    width: 100%;
    aspect-ratio: 1;
    border: 2px solid transparent;
    opacity: .6;
    cursor: pointer;
    transition: opacity 200ms ease, border-color 200ms ease;
  }

  .hero-thumbnails button[aria-pressed="true"],
  .hero-thumbnails button:hover {
    opacity: 1;
    border-color: var(--color-paper);
  }

  .hero-thumbnails img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-playback {
    margin-top: 8px;
    padding: 4px;
    font-size: 12px;
    text-decoration: underline;
    cursor: pointer;
  }

  @media (min-width: 960px) {
    .post-hero-heading {
      grid-template-columns: minmax(0, 1fr) minmax(0, 42%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-image {
      transition: none;
    }
  }

  .post-source {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 28px;
    padding-block: 22px;
    margin-bottom: 28px;
    border-bottom: 1px solid var(--color-line);
  }

  .post-source p {
    max-width: 62ch;
    font-style: italic;
  }

  :global([data-theme="dark"]) .post-source {
    border-color: var(--color-line-dark);
  }

  .recommendation-caption {
    background: linear-gradient(to top, oklch(12% .006 60 / .95), oklch(12% .006 60 / .65) 55%, transparent);
  }

  @media (max-width: 767px) {
    .post-hero {
      min-height: max(420px, 70svh);
    }
  }
</style>

<script>
  const setupImageFallbacks = () => {
    document.querySelectorAll<HTMLImageElement>("[data-fallback-image]").forEach((image) => {
      if (image.dataset.fallbackBound) return;
      image.dataset.fallbackBound = "true";
      image.dataset.fallbackIndex ??= "0";
      image.addEventListener("error", () => {
        const fallbackUrls = JSON.parse(image.dataset.fallbackUrls ?? "[]");
        const fallbackIndex = Number.parseInt(image.dataset.fallbackIndex ?? "0", 10);
        const fallbackCandidate = Array.isArray(fallbackUrls) && Number.isInteger(fallbackIndex) && fallbackIndex >= 0
          ? fallbackUrls[fallbackIndex]
          : undefined;
        const fallbackUrl = typeof fallbackCandidate === "string" && fallbackCandidate.length > 0 ? fallbackCandidate : undefined;
        if (fallbackUrl) {
          image.dataset.fallbackIndex = String(fallbackIndex + 1);
          image.src = fallbackUrl;
          return;
        }

        image.classList.add("invisible");
        image.nextElementSibling?.removeAttribute("class");
        image.nextElementSibling?.setAttribute("class", "absolute inset-0 flex items-center justify-center bg-gallery-empty text-no-image text-gallery-empty-text");
      }, { once: false });
    });
  };

  setupImageFallbacks();
  document.addEventListener("astro:page-load", setupImageFallbacks);

  document.querySelectorAll<HTMLAnchorElement>("[data-carousel-control]").forEach((control) => {
    control.addEventListener("click", (event) => {
      event.preventDefault();
      const targetId = control.getAttribute("href")?.slice(1);
      const target = targetId ? document.getElementById(targetId) : null;
      if (!target) return;
      target.scrollIntoView({
        behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
        block: "nearest",
        inline: "start",
      });
      window.history.replaceState(null, "", `${window.location.pathname}${window.location.search}`);
    });
  });

  let disposeHero: (() => void) | undefined;

  const setupHero = () => {
    disposeHero?.();
    const gallery = document.querySelector<HTMLElement>("[data-hero-gallery]");
    if (!gallery) return;
    const slides = Array.from(gallery.querySelectorAll<HTMLElement>("[data-hero-slide]"));
    const thumbnails = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-hero-thumbnail]"));
    const playback = document.querySelector<HTMLButtonElement>("[data-hero-playback]");
    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const controller = new AbortController();
    const options = { signal: controller.signal };
    let current = 0;
    let paused = motion.matches;
    let timer: ReturnType<typeof setInterval> | undefined;

    const show = (index: number) => {
      current = index;
      slides.forEach((slide, i) => {
        slide.dataset.active = String(i === current);
        slide.inert = i !== current;
      });
      thumbnails.forEach((thumbnail, i) => thumbnail.setAttribute("aria-pressed", String(i === current)));
    };

    const updatePlayback = () => {
      if (!playback) return;
      playback.textContent = paused ? "Play" : "Pause";
      playback.setAttribute("aria-label", paused ? "Start automatic image changes" : "Pause automatic image changes");
    };

    const schedule = () => {
      clearInterval(timer);
      if (paused || document.hidden || slides.length < 2) return;
      timer = setInterval(() => {
        if (!document.querySelector<HTMLDialogElement>("#hero-lightbox")?.open) {
          show((current + 1) % slides.length);
        }
      }, 5000);
    };

    thumbnails.forEach((thumbnail, index) => {
      thumbnail.addEventListener("click", () => {
        show(index);
        schedule();
      }, options);
    });
    playback?.addEventListener("click", () => {
      paused = !paused;
      updatePlayback();
      schedule();
    }, options);
    document.addEventListener("visibilitychange", schedule, options);
    motion.addEventListener("change", () => {
      paused = motion.matches;
      updatePlayback();
      schedule();
    }, options);
    updatePlayback();
    schedule();
    disposeHero = () => {
      clearInterval(timer);
      controller.abort();
    };
  };

  setupHero();
  document.addEventListener("astro:page-load", setupHero);
  document.addEventListener("astro:before-swap", () => disposeHero?.());

  const lightbox = document.getElementById("hero-lightbox") as HTMLDialogElement | null;
  const modalCarousel = lightbox?.querySelector<HTMLElement>("[data-modal-carousel]") ?? null;

  document.querySelectorAll<HTMLButtonElement>("[data-open-lightbox]").forEach((button) => {
    button.addEventListener("click", () => {
      if (!lightbox) return;
      lightbox.showModal();
      if (modalCarousel) {
        const idx = parseInt(button.getAttribute("data-open-lightbox") ?? "0", 10);
        const target = modalCarousel.querySelectorAll<HTMLElement>(".carousel-item")[idx];
        if (target) {
          requestAnimationFrame(() => {
            modalCarousel.scrollTo({ left: target.offsetLeft, behavior: "auto" });
          });
        }
      }
    });
  });

  if (lightbox && modalCarousel) {
    lightbox.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
      const items = Array.from(modalCarousel.querySelectorAll<HTMLElement>(".carousel-item"));
      if (items.length === 0) return;
      const w = modalCarousel.clientWidth || 1;
      const currentIdx = Math.min(items.length - 1, Math.max(0, Math.round(modalCarousel.scrollLeft / w)));
      const nextIdx = event.key === "ArrowLeft"
        ? (currentIdx === 0 ? items.length - 1 : currentIdx - 1)
        : (currentIdx === items.length - 1 ? 0 : currentIdx + 1);
      event.preventDefault();
      modalCarousel.scrollTo({ left: items[nextIdx].offsetLeft, behavior: "smooth" });
    });
  }
</script>
</content>
