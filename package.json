{
  "name": "movies-that-feel-like",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "npm run dev -w apps/astro",
    "build": "npm run build -w apps/astro",
    "build:production": "node scripts/build-production.mjs",
    "cf:deploy": "wrangler deploy --config apps/astro/dist/server/wrangler.json",
    "cf:deploy:prod": "npm run build:production -- --snapshot \"${D1_SNAPSHOT:?set D1_SNAPSHOT to a file from npm run d1:export:prod}\" && npm run cf:deploy",
    "d1:export:prod": "wrangler d1 export ${D1_DATABASE_NAME:-movies-that-feel-like} --remote --no-schema --skip-confirmation --config apps/astro/wrangler.jsonc",
    "check": "npm run validate-schema -w packages/db && npm run check -w apps/astro",
    "seed": "npm run pipeline:load -- --reset && npm run db:migrate",
    "pipeline:fetch": "npm run fetch -w apps/pipeline --",
    "pipeline:normalize": "npm run normalize -w apps/pipeline --",
    "pipeline:backfill-images": "npm run backfill-images -w apps/pipeline --",
    "pipeline:extract": "npm run extract -w apps/pipeline --",
    "pipeline:enrich": "npm run enrich -w apps/pipeline --",
    "pipeline:ingest": "npm run pipeline:normalize && npm run pipeline:extract && npm run pipeline:enrich && npm run seed",
    "pipeline:load": "npm run load -w apps/pipeline --",
    "pipeline:check-images": "npm run check-images -w apps/pipeline --",
    "pipeline:refetch-images": "npm run refetch-images -w apps/pipeline --",
    "pipeline:cache-sql": "npm run cache-sql -w apps/pipeline --",
    "pipeline:inspect": "npm run inspect -w apps/pipeline --",
    "db:migrate": "wrangler d1 migrations apply ${D1_DATABASE_NAME:-movies-that-feel-like} --local --config apps/astro/wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply ${D1_DATABASE_NAME:-movies-that-feel-like} --remote --config apps/astro/wrangler.jsonc"
  },
  "devDependencies": {
    "wrangler": "^4.83.0"
  }
}
